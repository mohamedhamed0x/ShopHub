@model CheckoutVM
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-4">
    <h2 class="section-title mb-4"><i class="bi bi-credit-card me-2"></i>Checkout</h2>

    <form asp-action="PlaceOrder" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Shipping Address -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt me-2"></i>Shipping Address</h5>

                        @if (Model.SavedAddresses.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-medium">Select a saved address</label>
                                @foreach (var addr in Model.SavedAddresses)
                                {
                                    <div class="form-check border rounded p-3 mb-2">
                                        <input class="form-check-input" type="radio" name="SelectedAddressId" value="@addr.Id" id="addr_@addr.Id"
                                               checked="@(addr.IsDefault)" />
                                        <label class="form-check-label ms-2" for="addr_@addr.Id">
                                            <strong>@addr.FullName</strong><br>
                                            <small class="text-muted">@addr.Street, @addr.City, @addr.State @addr.ZipCode, @addr.Country</small>
                                            @if (!string.IsNullOrEmpty(addr.Phone))
                                            {
                                                <br><small class="text-muted"><i class="bi bi-telephone me-1"></i>@addr.Phone</small>
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                            <hr>
                            <p class="text-muted small">Or enter a new address below:</p>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Full Name</label>
                                <input asp-for="NewFullName" class="form-control" placeholder="Full Name" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Street Address</label>
                                <input asp-for="NewStreet" class="form-control" placeholder="123 Main St" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input asp-for="NewCity" class="form-control" placeholder="City" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">State</label>
                                <input asp-for="NewState" class="form-control" placeholder="State" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Zip Code</label>
                                <input asp-for="NewZipCode" class="form-control" placeholder="12345" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Country</label>
                                <input asp-for="NewCountry" class="form-control" placeholder="Country" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Phone</label>
                                <input asp-for="NewPhone" class="form-control" placeholder="+1 (555) 000-0000" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-5">
                <div class="checkout-summary">
                    <h5 class="fw-bold mb-3">Order Summary</h5>
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="small fw-medium">@item.ProductName</span>
                                <span class="text-muted small">x@item.Quantity</span>
                            </div>
                            <span class="small">$@item.Subtotal.ToString("N2")</span>
                        </div>
                    }
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold">Total</span>
                        <span class="fw-bold fs-5" style="color: var(--primary-dark);">$@Model.TotalAmount.ToString("N2")</span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-bag-check me-1"></i> Place Order
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
