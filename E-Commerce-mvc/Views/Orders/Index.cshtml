@model OrderListVM
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <h2 class="section-title mb-4"><i class="bi bi-bag me-2"></i>My Orders</h2>

    @if (!Model.Orders.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x" style="font-size: 5rem; color: var(--text-secondary);"></i>
            <h4 class="mt-3">No orders yet</h4>
            <p class="text-muted">You haven't placed any orders yet.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-bag me-1"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td class="fw-medium">#@order.OrderId</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>@order.ItemCount item(s)</td>
                            <td class="fw-semibold">$@order.TotalAmount.ToString("N2")</td>
                            <td>
                                <span class="status-badge status-@order.Status.ToString().ToLower()">@order.Status</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">
                                    Details <i class="bi bi-chevron-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
