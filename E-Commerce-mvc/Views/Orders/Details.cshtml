@model OrderDetailsVM
@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">My Orders</a></li>
            <li class="breadcrumb-item active">Order #@Model.OrderId</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Order #@Model.OrderId</h2>
        <span class="status-badge status-@Model.Status.ToString().ToLower()" style="font-size: 0.9rem;">@Model.Status</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Order Items -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Order Items</h5>
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div class="d-flex align-items-center">
                                @if (item.ImageUrl != null)
                                {
                                    <img src="@item.ImageUrl" class="cart-item-img me-3" alt="@item.ProductName">
                                }
                                else
                                {
                                    <div class="cart-item-img img-placeholder me-3 d-flex align-items-center justify-content-center rounded" style="font-size:1.2rem;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                                <div>
                                    <span class="fw-medium">@item.ProductName</span>
                                    <br><small class="text-muted">Qty: @item.Quantity × $@item.UnitPrice.ToString("N2")</small>
                                </div>
                            </div>
                            <span class="fw-semibold">$@item.Subtotal.ToString("N2")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between mt-3">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-5" style="color: var(--primary-dark);">$@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Shipping Address -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt me-2"></i>Shipping Address</h5>
                    <p class="mb-1 fw-medium">@Model.ShippingAddress.FullName</p>
                    <p class="mb-1 text-muted">@Model.ShippingAddress.Street</p>
                    <p class="mb-1 text-muted">@Model.ShippingAddress.City, @Model.ShippingAddress.State @Model.ShippingAddress.ZipCode</p>
                    <p class="mb-0 text-muted">@Model.ShippingAddress.Country</p>
                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Phone))
                    {
                        <p class="mb-0 text-muted mt-1"><i class="bi bi-telephone me-1"></i>@Model.ShippingAddress.Phone</p>
                    }
                </div>
            </div>

            <!-- Order Info -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Order Info</h5>
                    <p class="mb-1"><strong>Date:</strong> @Model.OrderDate.ToString("MMMM dd, yyyy hh:mm tt")</p>
                    <p class="mb-1"><strong>Status:</strong> <span class="status-badge status-@Model.Status.ToString().ToLower()">@Model.Status</span></p>

                    @if (Model.Status == OrderStatus.Pending)
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.OrderId" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100"
                                    onclick="return confirm('Are you sure you want to cancel this order?');">
                                <i class="bi bi-x-circle me-1"></i> Cancel Order
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
