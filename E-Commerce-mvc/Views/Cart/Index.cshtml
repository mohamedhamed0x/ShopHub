@model CartVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-4">
    <h2 class="section-title mb-4"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h2>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 5rem; color: var(--text-secondary);"></i>
            <h4 class="mt-3">Your cart is empty</h4>
            <p class="text-muted">Looks like you haven't added anything yet.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-bag me-1"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table align-middle cart-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (item.ImageUrl != null)
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="cart-item-img me-3">
                                            }
                                            else
                                            {
                                                <div class="cart-item-img img-placeholder me-3 d-flex align-items-center justify-content-center rounded" style="font-size:1.2rem;">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                            <div>
                                                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none fw-medium text-dark">
                                                    @item.ProductName
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                    <td>$@item.UnitPrice.ToString("N2")</td>
                                    <td>
                                        <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity"
                                                   class="form-control form-control-sm qty-input" onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td class="fw-semibold">$@item.Subtotal.ToString("N2")</td>
                                    <td>
                                        <form asp-action="RemoveItem" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Cart Summary -->
            <div class="col-lg-4">
                <div class="checkout-summary">
                    <h5 class="fw-bold mb-3">Order Summary</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Items (@Model.ItemCount)</span>
                        <span>$@Model.TotalAmount.ToString("N2")</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold">Total</span>
                        <span class="fw-bold fs-5" style="color: var(--primary-dark);">$@Model.TotalAmount.ToString("N2")</span>
                    </div>
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary w-100 py-2">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
</div>
